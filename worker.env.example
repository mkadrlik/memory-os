# Memory OS — native worker environment (no secrets).
# Copy to worker.env and fill REDIS_PASSWORD / OPENROUTER_API_KEY.

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMS=4096
COLLECTION_NAME=knowledge_base
WIKI_PATH=/absolute/path/to/vault/wiki
LOG_LEVEL=INFO
ARQ_JOB_TIMEOUT=300
ARQ_MAX_JOBS=10
ARQ_KEEP_RESULT=3600
STATE_DB_PATH=/absolute/path/to/hermes-profile/state.db
LLM_BACKEND=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
